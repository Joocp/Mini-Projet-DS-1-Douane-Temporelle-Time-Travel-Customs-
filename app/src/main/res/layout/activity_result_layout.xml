<?xml version="1.0" encoding="utf-8"?>

<!--el conteneur el principal mta3 l'ecran -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_result_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp" >


    <!--TextView bech yaffichi el verdict (accepté wala refusé) -->
    <TextView
        android:id="@+id/txt_verdict_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verdict"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!--TextView bech yaffichi message personnaliser lel voyageur -->
    <TextView
        android:id="@+id/txt_message_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Message du Voyageur"
        android:textSize="20sp" />

    <!--bouton bech el utilisateur ynajem yabda voyage jdid -->
    <Button
        android:id="@+id/btn_nouveau_1"
        android:layout_width="164dp"
        android:layout_height="65dp"
        android:layout_marginTop="30dp"
        android:text="Nouveau Voyageur" />
</LinearLayout>