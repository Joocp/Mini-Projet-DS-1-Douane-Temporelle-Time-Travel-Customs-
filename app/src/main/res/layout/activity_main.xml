<?xml version="1.0" encoding="utf-8"?>

<!--ScrollView: Najmout nestamlou aka assenseur eli yatl3ik w yabtek el fouk w el louta w ala el ymin w el lissar fel interface mta el application mte3na-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="24dp">
    <!--Yhot les elements ala kobr el interface verticalement et horzantalement-->

    <!--Yssafaf les elements ta7t b3adhom-->
    <LinearLayout
        android:id="@+id/layout_formulaire_os"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp"
        >
        <!--android:id-> Najmou ngamrou beha LinearLayout beach nmanipuliwhom fel code mta el java-->

        <!-- Titre mata el Application -->
        <TextView
            android:id="@+id/txt_titre_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />
        <!-- Champ mta nom de voyageur -->
        <TextView
            android:id="@+id/txt_nom_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du voyageur"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_nom_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Saisir le nom du voyageur"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />
        <!-- champ mta annee de naissance -->
        <TextView
            android:id="@+id/txt_naissance_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Année de naissance"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_naissance_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Exemple : 1990"
            android:inputType="number"
            android:layout_marginBottom="16dp" />
        <!-- champ mta annee de destination -->
        <TextView
            android:id="@+id/txt_destination_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Année de destination"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_destination_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Exemple : 2050"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />
        <!--Champ mta Motife de voyage -->
        <TextView
            android:id="@+id/txt_motif_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motif du voyage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_motif_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_tourisme_os"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Tourisme" />

            <RadioButton
                android:id="@+id/rb_passe_os"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Modification du passé" />

            <RadioButton
                android:id="@+id/rb_fuite_os"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Fuite" />

        </RadioGroup>



    </LinearLayout>

</ScrollView>